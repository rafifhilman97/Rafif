#include <stdio.h>

int minInt(int a, int b) {
    if (a<b){
        return a;
    }
    else{
        return b;
    }
}

// Menuangkan isi dari *sumber ke *tujuan (kapasitas tujuan = kapTujuan)
void tuang(int *sumber, int *tujuan, int kapTujuan, int *langkah) {
    int ruangTersedia = kapTujuan - *tujuan;
    if (*sumber <= ruangTersedia) {
        *tujuan += *sumber;
        *sumber = 0;
    } else {
        *sumber -= ruangTersedia;
        *tujuan = kapTujuan;
    }
    (*langkah)++;
}

void isiPenuh(int *gelas, int ukuran, int *langkah){
    *gelas = ukuran;
    (*langkah)++;
}

void kosongkan(int *gelas, int *langkah){
    *gelas = 0;
    (*langkah)++;
}

int NilaiFPB(int ukuranA, int ukuranB){ // [1]
    int sisa = ukuranA % ukuranB;
    while ((sisa) != 0){
        ukuranA = ukuranB;
        ukuranB = sisa;
        sisa = ukuranA % ukuranB;
    }
    return ukuranB;
}

// Simulasi satu arah: isi/tuang dari gelas1 ke gelas2
int simulasiSatuArah(int kap1, int kap2, int target) {
    int gelas1 = 0, gelas2 = 0;
    int langkah = 0;
    
    while (gelas1 != target && gelas2 != target) {
        if (gelas1 == 0) {
            isiPenuh(&gelas1, kap1, &langkah);
        } else if (gelas2 == kap2) {
            kosongkan(&gelas2, &langkah);
        } else {
            tuang(&gelas1, &gelas2, kap2, &langkah);
        }
    }
    return langkah;
}

int langkahMinimum(int ukuranA, int ukuranB, int takaran){
    int FPB = NilaiFPB(ukuranA, ukuranB);
    
    if (ukuranA == takaran || ukuranB == takaran){
        return 1;
    }
    else if (ukuranA < takaran && ukuranB < takaran){
        return -1;
    }
    else if(ukuranA == ukuranB && ukuranA != takaran){
        return -1;
    }
    else if(takaran % FPB != 0){
        return -1;
    }
    else {
        int arahAB = simulasiSatuArah(ukuranA, ukuranB, takaran);
        int arahBA = simulasiSatuArah(ukuranB, ukuranA, takaran);
        return minInt(arahAB, arahBA);
    }
}

int main(void){
    int gelasA;
    int gelasB;
    int takaran;
    scanf("%d %d %d", &gelasA, &gelasB, &takaran);

    printf("%d", langkahMinimum(gelasA, gelasB, takaran));

    return 0;
}
